.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding-bottom: env(safe-area-inset-bottom);
  background: transparent;
}

.tab-bar__blur {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.92);
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 -8rpx 28rpx rgba(40, 20, 10, 0.06);
}

.tab-bar__inner {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 110rpx;
  padding: 0 8rpx 10rpx;
  box-sizing: border-box;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  transition: transform 0.2s ease;
}

.tab-item.on {
  transform: translateY(-2rpx);
}

.tab-icon-wrap {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon-bg {
  position: absolute;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: rgba(250, 65, 38, 0.1);
  transform: scale(0.92);
}

.tab-icon-wrap.bump {
  animation: cart-bump 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.4);
}

@keyframes cart-bump {
  0% {
    transform: scale(1);
  }
  35% {
    transform: scale(1.28);
  }
  70% {
    transform: scale(0.92);
  }
  100% {
    transform: scale(1);
  }
}

.tab-badge {
  position: absolute;
  top: -4rpx;
  right: -14rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 14rpx;
  background: #fa4126;
  color: #fff;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
  box-sizing: border-box;
  border: 2rpx solid #fff;
}

.tab-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #9a9a9a;
  line-height: 1.2;
}

.tab-item.on .tab-text {
  color: #fa4126;
  font-weight: 600;
}
