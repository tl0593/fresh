.cat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #fff;
  box-sizing: border-box;
  padding-bottom: calc(112rpx + env(safe-area-inset-bottom));
}

.cat-search {
  padding: 16rpx 24rpx 8rpx;
  background: #fff;
  flex-shrink: 0;
}

.cat-search__bar {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 8rpx 0 24rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
}

.cat-search__input {
  flex: 1;
  margin: 0 16rpx;
  font-size: 28rpx;
  color: #333;
}

.cat-search__btn {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 28rpx;
  background: #2e7d32;
  color: #fff;
  font-size: 26rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
}

.cat-roots {
  white-space: nowrap;
  padding: 12rpx 16rpx 20rpx;
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
}

.cat-root {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 128rpx;
  margin-right: 8rpx;
  vertical-align: top;
}

.cat-root__icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid transparent;
  box-sizing: border-box;
  background: #f3f6f3;
}

.cat-root--active .cat-root__icon-wrap {
  border-color: #2e7d32;
}

.cat-root__icon {
  width: 100%;
  height: 100%;
}

.cat-root__icon--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #2e7d32;
  font-weight: 600;
}

.cat-root__name {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #666;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cat-root--active .cat-root__name {
  color: #2e7d32;
  font-weight: 600;
}

.cat-body {
  flex: 1;
  display: flex;
  min-height: 0;
  border-top: 1rpx solid #f0f0f0;
}

.cat-side {
  width: 176rpx;
  height: 100%;
  background: #f5f5f5;
  flex-shrink: 0;
}

.cat-side__item {
  padding: 28rpx 12rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
  line-height: 1.35;
  position: relative;
}

.cat-side__item--active {
  background: #fff;
  color: #2e7d32;
  font-weight: 600;
}

.cat-side__item--active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 36rpx;
  background: #2e7d32;
  border-radius: 0 4rpx 4rpx 0;
}

.cat-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  background: #fff;
}

.cat-sort {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
  flex-shrink: 0;
}

.cat-sort__item {
  display: flex;
  align-items: center;
  margin-right: 40rpx;
  font-size: 26rpx;
  color: #666;
}

.cat-sort__item--active {
  color: #2e7d32;
  font-weight: 600;
}

.cat-sort__arrows {
  display: flex;
  flex-direction: column;
  margin-left: 6rpx;
  gap: 2rpx;
}

.arrow {
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
}

.arrow-up {
  border-bottom: 8rpx solid #ccc;
}

.arrow-down {
  border-top: 8rpx solid #ccc;
}

.arrow--on.arrow-up {
  border-bottom-color: #2e7d32;
}

.arrow--on.arrow-down {
  border-top-color: #2e7d32;
}

.cat-goods {
  flex: 1;
  height: 0;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.cat-loading,
.cat-empty {
  padding-top: 120rpx;
  display: flex;
  justify-content: center;
}

.goods-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-row__img {
  width: 176rpx;
  height: 176rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f7f7f7;
  overflow: hidden;
}

.goods-row__img-inner {
  width: 176rpx;
  height: 176rpx;
  display: block;
}

.goods-row__body {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.goods-row__title {
  font-size: 28rpx;
  color: #222;
  font-weight: 500;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods-row__meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.goods-row__foot {
  margin-top: auto;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.goods-row__price {
  color: #e53935 !important;
  font-size: 34rpx !important;
  font-weight: 600;
}

.goods-row__price-symbol {
  color: #e53935 !important;
  font-size: 24rpx !important;
}

.goods-row__add {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #2e7d32;
  color: #fff;
  font-size: 36rpx;
  line-height: 44rpx;
  text-align: center;
  font-weight: 400;
}

page {
  height: 100%;
  background: #fff;
}
