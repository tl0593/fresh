<view class="goods-category custom-class">
  <scroll-view class="goods-category__side" scroll-y>
    <view
      wx:for="{{sideList}}"
      wx:key="index"
      class="side-item side-item--{{item.type}} {{activeSideIndex === index ? 'side-item--active' : ''}} {{item.disabled ? 'side-item--disabled' : ''}}"
      data-index="{{index}}"
      bindtap="onSideTap"
    >
      <text class="side-item__text">{{item.name}}</text>
    </view>
  </scroll-view>

  <view class="goods-category__right">
    <view class="goods-category-normal" wx:if="{{category.length && category[activeKey]}}">
      <!-- 三级分类：右侧按二级分组展示 -->
      <block wx:if="{{level === 3}}">
        <block wx:for="{{category[activeKey].children}}" wx:key="groupId" wx:for-index="gIndex">
          <view
            class="goods-category-normal-item"
            wx:if="{{item.children && item.children.length > 0 && (sideList[activeSideIndex].type === 'parent' || subActiveKey === gIndex)}}"
          >
            <view class="flex goods-category-normal-item-title">{{item.name}}</view>
            <view class="goods-category-normal-item-container">
              <view
                class="goods-category-normal-item-container-item"
                wx:for="{{item.children}}"
                wx:for-index="subIndex"
                wx:key="groupId"
                wx:for-item="subItem"
                bindtap="changCategory"
                data-item="{{subItem}}"
              >
                <t-image src="{{subItem.thumbnail}}" t-class="image" />
                <view class="flex goods-category-normal-item-container-item-title">{{subItem.name}}</view>
              </view>
            </view>
          </view>
        </block>
      </block>

      <!-- 二级分类：右侧直接展示子分类格子 -->
      <view class="goods-category-normal-item-second-container" wx:if="{{level === 2}}">
        <block wx:for="{{category[activeKey].children}}" wx:key="groupId" wx:for-index="cIndex">
          <view
            class="goods-category-normal-item-second-container-item {{subActiveKey === cIndex && sideList[activeSideIndex].type === 'child' ? 'is-active' : ''}}"
            bindtap="changCategory"
            data-item="{{item}}"
          >
            <t-image src="{{item.thumbnail}}" t-class="image" />
            <view class="flex goods-category-normal-item-container-item-title">{{item.name}}</view>
          </view>
        </block>
      </view>
    </view>
  </view>
</view>
