.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f3f6f4;
}
.chat {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}
.bubble {
  max-width: 80%;
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  white-space: pre-wrap;
}
.bubble.user {
  margin-left: auto;
  background: #2e7d32;
  color: #fff;
}
.bubble.ai {
  background: #fff;
  color: #333;
}
.toolbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
}
.cook {
  font-size: 22rpx;
  color: #2e7d32;
  white-space: nowrap;
}
.input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  font-size: 28rpx;
}
.send {
  color: #fff;
  background: #2e7d32;
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
}
