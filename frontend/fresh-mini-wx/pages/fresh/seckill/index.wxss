.page {
  padding: 24rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #ffe8e0 0%, #f7f7f7 40%);
}
.card {
  position: relative;
  background: #fff;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}
.tag {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  background: #e65100;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.title {
  font-size: 32rpx;
  font-weight: 600;
  padding-right: 80rpx;
}
.meta {
  margin-top: 12rpx;
  color: #888;
  font-size: 24rpx;
}
.price {
  margin-top: 16rpx;
  color: #e65100;
  font-size: 36rpx;
  font-weight: 700;
}
.empty {
  text-align: center;
  color: #999;
  padding: 120rpx 0;
}
