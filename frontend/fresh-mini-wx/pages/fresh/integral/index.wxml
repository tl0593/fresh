<view class="mall">
  <view class="hero">
    <view class="hero-brand">FRESH 积分商城</view>
    <view class="hero-points">
      <text class="label">可用积分</text>
      <text class="num">{{integral}}</text>
    </view>
    <view class="hero-desc">积分兑券 · 积分抽奖，优惠券到账后可在结算时使用</view>
  </view>

  <view class="tabs">
    <view class="tab {{tab==='exchange'?'on':''}}" data-tab="exchange" bindtap="onTab">积分兑券</view>
    <view class="tab {{tab==='lottery'?'on':''}}" data-tab="lottery" bindtap="onTab">积分抽奖</view>
    <view class="tab {{tab==='log'?'on':''}}" data-tab="log" bindtap="onTab">积分流水</view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中...</view>

  <block wx:elif="{{tab==='exchange'}}">
    <view class="section-tip">用积分直接兑换指定优惠券，每日限兑以配置为准</view>
    <view wx:if="{{!exchangeList.length}}" class="empty">暂无可兑换优惠券</view>
    <view class="card" wx:for="{{exchangeList}}" wx:key="id">
      <view class="card-left">
        <view class="yen">¥</view>
        <view class="amount">{{item.value / 100}}</view>
        <view class="thr">{{item.base > 0 ? ('满' + item.base / 100 + '可用') : '无门槛'}}</view>
      </view>
      <view class="card-mid">
        <view class="title">{{item.title}}</view>
        <view class="meta">剩余 {{item.remainStock}} · 日限 {{item.dailyLimit}}</view>
        <view class="cost">{{item.costIntegral}} 积分</view>
      </view>
      <view
        class="btn {{item.remainStock<=0 || exchangingId===item.id ? 'disabled' : ''}}"
        data-id="{{item.id}}"
        data-cost="{{item.costIntegral}}"
        bindtap="onExchange"
      >{{item.remainStock<=0 ? '已兑完' : '兑换'}}</view>
    </view>
  </block>

  <block wx:elif="{{tab==='lottery'}}">
    <view class="lottery-panel">
      <view class="section-tip">每次消耗 {{costIntegral}} 积分，随机获得积分或优惠券</view>
      <view class="prize-grid">
        <view class="prize" wx:for="{{prizes}}" wx:key="id">
          <view class="prize-name">{{item.rewardName || (item.rewardType===1 ? (item.rewardIntegral+'积分') : '优惠券')}}</view>
          <view class="prize-weight">权重 {{item.weight}}</view>
        </view>
      </view>
      <view class="draw-result" wx:if="{{drawResult}}">{{drawResult}}</view>
      <view class="draw-btn {{drawing?'disabled':''}}" bindtap="onDraw">
        {{drawing ? '抽奖中...' : ('抽一次 · ' + costIntegral + '积分')}}
      </view>
    </view>
  </block>

  <block wx:else>
    <view wx:if="{{!logs.length}}" class="empty">暂无积分记录</view>
    <view class="log-card" wx:for="{{logs}}" wx:key="id">
      <view class="row">
        <text class="title">{{item.remark || '积分变动'}}</text>
        <text class="num {{item.changeNum >= 0 ? 'plus' : 'minus'}}">{{item.changeNum >= 0 ? '+' : ''}}{{item.changeNum || 0}}</text>
      </view>
      <view class="time">{{item.createTime}}</view>
    </view>
  </block>
</view>
