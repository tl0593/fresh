.page {
  padding: 24rpx;
  min-height: 100vh;
  background: #f7f7f7;
}
.card {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  border-left: 6rpx solid #2e7d32;
}
.card.read {
  border-left-color: #ccc;
  opacity: 0.75;
}
.title {
  font-size: 30rpx;
  font-weight: 600;
}
.content {
  margin-top: 12rpx;
  color: #555;
  font-size: 26rpx;
  line-height: 1.5;
}
.time {
  margin-top: 12rpx;
  color: #aaa;
  font-size: 22rpx;
}
.empty {
  text-align: center;
  color: #999;
  padding: 120rpx 0;
}
