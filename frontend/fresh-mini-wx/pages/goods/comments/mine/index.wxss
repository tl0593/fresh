.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f5f5f5;
  box-sizing: border-box;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.goods {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}
.time {
  font-size: 22rpx;
  color: #999;
}
.content {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}
.imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
}
.reply {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #f7f7f7;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}
.empty,
.loading {
  padding-top: 160rpx;
  text-align: center;
  color: #999;
}
