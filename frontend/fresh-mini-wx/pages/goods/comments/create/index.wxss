page {
  background: #f5f5f5;
}

.page {
  padding: 24rpx 24rpx 0;
  padding-bottom: calc(env(safe-area-inset-bottom) + 160rpx);
  box-sizing: border-box;
  min-height: 100vh;
}

.page-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.page-head-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.one-click {
  font-size: 24rpx;
  color: #666;
  background: #ececec;
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
}

.goods-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx 20rpx;
  margin-bottom: 20rpx;
}

.goods-row {
  display: flex;
  align-items: flex-start;
}

.goods-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #f2f2f2;
  display: block;
}

.goods-meta {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
}

.goods-title {
  font-size: 28rpx;
  color: #222;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.goods-spec {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.attitude {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 8rpx;
}

.attitude-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
}

.attitude-btn.on.good {
  background: rgba(7, 193, 96, 0.12);
}

.attitude-btn.on.bad {
  background: rgba(250, 65, 38, 0.1);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.tag {
  font-size: 24rpx;
  color: #666;
  background: #f3f3f3;
  padding: 12rpx 22rpx;
  border-radius: 8rpx;
  border: 1rpx solid transparent;
}

.tag.on {
  color: #fa4126;
  background: rgba(250, 65, 38, 0.08);
  border-color: rgba(250, 65, 38, 0.35);
}

.textarea-wrap {
  margin-top: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  overflow: hidden;
}

.textarea-wrap .textarea {
  min-height: 180rpx;
  background: #f5f5f5 !important;
  font-size: 26rpx;
  padding: 20rpx !important;
}

.upload-row {
  margin-top: 20rpx;
  position: relative;
}

.upload-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #bbb;
  line-height: 1.4;
}

.declare-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 8rpx;
}

.declare-row .t-checkbox {
  padding: 0 !important;
}

.declare-row .t-checkbox__content {
  display: none;
}

.declare-text {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.safe-bottom {
  height: 20rpx;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 16rpx);
  background: #fff;
  box-sizing: border-box;
}

.submit-btn {
  --td-button-default-color: #fff;
  --td-button-default-bg-color: #fa4126;
  --td-button-default-border-color: #fa4126;
  --td-button-default-active-bg-color: #e03820;
  width: 100%;
}

.submit-btn.disabled {
  --td-button-default-bg-color: #ccc;
  --td-button-default-border-color: #ccc;
  --td-button-default-active-bg-color: #bbb;
}
