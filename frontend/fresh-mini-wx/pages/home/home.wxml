<view class="home-page" wx:if="{{!pageLoading}}">
  <!-- 顶部渐变区：搜索 + 现时折扣轮播 -->
  <view class="home-hero">
    <view class="home-search" bind:tap="navToSearchPage">
      <t-icon name="search" size="36rpx" color="#999" />
      <text class="home-search__placeholder">搜索新鲜果蔬、肉蛋奶</text>
      <view class="home-search__btn">搜索</view>
    </view>

    <!-- 现时折扣：固定文案 + 横向滑动秒杀（最多10个，末尾查看更多） -->
    <view class="discount-panel">
      <view class="discount-panel__head">
        <view class="discount-panel__titles">
          <text class="discount-panel__title">社区生鲜现时折扣</text>
          <view class="discount-panel__sub">
            限时秒杀特惠，新鲜直达不踩坑
          </view>
        </view>
        <view class="discount-panel__more" bind:tap="navToSeckill">查看详情 ›</view>
      </view>

      <scroll-view
        class="discount-scroll"
        scroll-x
        enhanced
        show-scrollbar="{{false}}"
        enable-flex
      >
        <view class="discount-scroll__inner">
          <view
            wx:for="{{discountList}}"
            wx:key="id"
            class="discount-item"
            data-id="{{item.spuId}}"
            bind:tap="onDiscountTap"
          >
            <view class="discount-item__img-wrap">
              <t-image
                src="{{item.thumb}}"
                t-class="discount-item__img"
                mode="aspectFill"
              />
            </view>
            <view class="discount-item__price">
              <text class="yen">¥</text>{{item.priceLabel}}
            </view>
            <view class="discount-item__cta">去抢购</view>
          </view>

          <view
            wx:if="{{discountList.length}}"
            class="discount-more"
            bind:tap="navToSeckill"
          >
            <text class="discount-more__text">查看更多</text>
            <view class="discount-more__arrow">›</view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 商品大类 -->
  <view class="cat-section" wx:if="{{categories.length}}">
    <view class="cat-section__title">商品大类</view>
    <view class="cat-grid">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="cat-grid__item"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        bind:tap="onCategoryTap"
      >
        <view class="cat-grid__icon-wrap">
          <t-image src="{{item.icon}}" t-class="cat-grid__icon" mode="aspectFill" />
        </view>
        <text class="cat-grid__name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- Tab + 双列商品 -->
  <view class="home-feed">
    <view class="home-page-tabs">
      <t-tabs
        t-class="t-tabs"
        t-class-active="tabs-external__active"
        t-class-item="tabs-external__item"
        defaultValue="{{0}}"
        space-evenly="{{false}}"
        bind:change="tabChangeHandle"
      >
        <t-tab-panel
          wx:for="{{tabList}}"
          wx:for-index="index"
          wx:key="index"
          label="{{item.text}}"
          value="{{item.key}}"
        />
      </t-tabs>
    </view>

    <goods-list
      wr-class="goods-list-container"
      goodsList="{{goodsList}}"
      bind:click="goodListClickHandle"
      bind:addcart="goodListAddCartHandle"
    />
    <load-more list-is-empty="{{!goodsList.length}}" status="{{goodsListLoadStatus}}" bind:retry="onReTry" />
  </view>

  <t-toast id="t-toast" />

  <!-- 加购飞入购物车 -->
  <block wx:for="{{flyBalls}}" wx:key="id">
    <view
      class="fly-ball {{item.flying ? 'flying' : ''}}"
      style="left: {{item.x}}px; top: {{item.y}}px;"
    >
      <image wx:if="{{item.thumb}}" class="fly-ball__img" src="{{item.thumb}}" mode="aspectFill" />
      <view wx:else class="fly-ball__dot">+</view>
    </view>
  </block>
</view>

<view class="home-loading" wx:else>
  <t-loading theme="circular" size="40rpx" text="加载中..." inherit-color />
</view>
